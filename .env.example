# StudioOS environment — all provider keys optional (mock adapters used by default)
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Auth
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars

# Database
DATABASE_URL=postgresql://studio:studio@localhost:5432/studioos

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=studioos
S3_SECRET_KEY=studioossecret
S3_BUCKET=studioos
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Optional AI provider keys (leave empty to use mock adapters)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
HIGGSFIELD_API_KEY=
FAL_API_KEY=

# Feature flags
USE_MOCK_PROVIDERS=true
DEFAULT_QUALITY_MODE=draft

# Optional durable workflow (Temporal). Unset → BullMQ when REDIS_URL, else in-process.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default

# Optional Stripe billing (unset → MockBillingProvider)
STRIPE_SECRET_KEY=

# Optional OpenTelemetry OTLP/HTTP (unset → in-memory tracer only)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=studio-os-api

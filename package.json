{
  "name": "studio-os",
  "version": "0.1.0",
  "private": true,
  "description": "StudioOS — Creative Production Operating System",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @studio-os/db generate",
    "db:migrate": "pnpm --filter @studio-os/db migrate",
    "db:seed": "pnpm --filter @studio-os/db seed",
    "db:studio": "pnpm --filter @studio-os/db studio",
    "docker:up": "docker compose -f infra/docker/compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/compose.yml down",
    "dev:all": "turbo run dev --filter=@studio-os/api --filter=@studio-os/web --filter=@studio-os/generation-worker --filter=@studio-os/media-worker --filter=@studio-os/render-worker",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
